			<key>other</key>
			<string>%lld items in the Trash</string>
		</dict>
	</dict>
	<key>Permanently delete %lld items?</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Permanently delete %lld item?</string>
			<key>other</key>
			<string>Permanently delete %lld items?</string>
		</dict>
	</dict>
	<key>Moved %lld items to the Trash</key>
